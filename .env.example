# Publieke configuratie — vervang door de adressen van je eigen website en agenda.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_BOOKING_URL=https://example.com/afspraken

# Databaseverbinding
DATABASE_URL=

# Authenticatie — genereer een unieke secret en een bcrypt-wachtwoordhash.
AUTH_SECRET=
ADMIN_EMAIL=beheer@example.com
ADMIN_PASSWORD_HASH=

# Afbeeldingsopslag
BLOB_READ_WRITE_TOKEN=

# E-mail
RESEND_API_KEY=
RESEND_FROM="Praktijk <noreply@example.com>"
